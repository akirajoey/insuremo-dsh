{
  "name": "icomposer-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "install": "pnpm install --ignore-scripts",
    "check": "node scripts/check-compatibility.mjs",
    "setup-profile": "node scripts/setup-profile.mjs",
    "bundle": "pnpm --filter @icomposer/ui-insuremo-settings --filter @icomposer/ui-insuremo-status --filter @icomposer/ui-workbench-jobs run bundle",
    "bundle:client": "pnpm --filter @icomposer/ui-insuremo-settings --filter @icomposer/ui-insuremo-status --filter @icomposer/ui-workbench-jobs run bundle",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "pack:dist": "node scripts/pack-dist.mjs",
    "pack:git-dist": "node scripts/pack-git-dist.mjs",
    "check:git-dist": "node scripts/check-git-dist.mjs",
    "pack:bootstrap:stable": "node scripts/pack-bootstrap.mjs stable",
    "pack:bootstrap:next": "node scripts/pack-bootstrap.mjs next",
    "pack:bootstrap": "pnpm pack:bootstrap:stable && pnpm pack:bootstrap:next",
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "test:bootstrap": "node --test test/bootstrap.test.mjs test/bootstrap-safety.test.mjs",
    "test:git-dist": "node --test --test-concurrency=1 test/git-dist.test.mjs test/pack-git-dist.test.mjs",
    "test:git-install": "node test/git-install.e2e.mjs"
  }
}
